{
  "source": "ATP MariaDB via repository read-only atp-tennis skill",
  "checked_at": "2026-11-04T00:01:20.463909+01:00",
  "population": "All players, active and retired; all surfaces; Masters main draws since 1990 in database",
  "status_filter": "Completed only; qualifying, Aborted and Walkover excluded",
  "minimum_matches": 100,
  "calculation": "wins/(wins+losses); one appearance per eligible match per player",
  "sort": "unrounded win percentage descending, matches descending, ATP ID",
  "query": "WITH eligible AS (\n SELECT m.winner,m.loser FROM matches m JOIN events e ON e.id=m.event\n WHERE e.type=%s AND m.status=%s AND m.round IN ('R128','R64','R32','R16','QF','SF','F')\n), outcomes AS (\n SELECT winner AS player_id,1 AS win,0 AS loss FROM eligible\n UNION ALL SELECT loser AS player_id,0 AS win,1 AS loss FROM eligible\n)\nSELECT p.id,p.name,SUM(o.win) AS wins,SUM(o.loss) AS losses,COUNT(*) AS matches,\n ROUND(100.0*SUM(o.win)/COUNT(*),2) AS win_pct\nFROM outcomes o JOIN players p ON p.id=o.player_id\nGROUP BY p.id,p.name HAVING COUNT(*) >= %s\nORDER BY SUM(o.win)/COUNT(*) DESC,COUNT(*) DESC,p.id LIMIT 20",
  "params": [
    "Masters",
    "Completed",
    100
  ],
