  "population": "Singles main draws of events.type=Masters, all players including retired, all surfaces",
  "status_filter": "Completed only; excludes Aborted, Walkover, qualification",
  "calculation": "COUNT(*) per matches.winner ATP ID",
  "sort": "wins descending, name then ATP ID",
  "query": "SELECT p.id,p.name,COUNT(*) AS wins FROM matches m JOIN events e ON e.id=m.event JOIN players p ON p.id=m.winner WHERE e.type=%s AND m.status=%s AND m.round IN ('R128','R64','R32','R16','QF','SF','F') GROUP BY p.id,p.name ORDER BY wins DESC,p.name,p.id LIMIT 20",
